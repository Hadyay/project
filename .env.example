# --- Database ---
POSTGRES_USER=erp
POSTGRES_PASSWORD=erp_dev_password
POSTGRES_DB=realestate_erp
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Inside docker compose the backend reaches the DB as host `db` on 5432:
DATABASE_URL=postgresql+psycopg://erp:erp_dev_password@db:5432/realestate_erp

# Running the backend on the host instead? The container publishes 5433,
# because port 5432 is taken by a locally installed Postgres service:
# DATABASE_URL=postgresql+psycopg://erp:erp_dev_password@localhost:5433/realestate_erp

# --- Backend / Auth ---
JWT_SECRET=change_me_dev_secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
BACKEND_CORS_ORIGINS=http://localhost:3000

# --- Tests ---
TEST_DATABASE_URL=postgresql+psycopg://erp:erp_dev_password@localhost:5433/realestate_erp_test

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
