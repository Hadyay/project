{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "cmd.exe",
      "runtimeArgs": ["/c", "cd /d backend && .venv\\Scripts\\python.exe -m uvicorn app.main:app --reload --port 8000"],
      "port": 8000
    },
    {
      "name": "frontend",
      "runtimeExecutable": "cmd.exe",
      "runtimeArgs": ["/c", "cd /d frontend && npm run dev"],
      "port": 3000
    }
  ]
}
